# Variables d'environnement - Lab Planner V3
# Copier ce fichier en .env pour personnaliser

# ============================================
# Configuration de l'application
# ============================================

# Niveau de logging : DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Nombre de workers pour le ThreadPoolExecutor
WORKERS=4

# ============================================
# Configuration Docker
# ============================================

# Limites de ressources
CPU_LIMIT=2.0
MEMORY_LIMIT=512M

# ============================================
# Chemins (pour développement local)
# ============================================

# Dossier de sortie pour les résultats JSON
OUTPUT_DIR=./output

# Dossier pour les logs
LOG_DIR=./logs

# ============================================
# Future configuration (API REST)
# ============================================

# Port pour l'API (quand implémentée)
# API_PORT=8000

# Host de l'API
# API_HOST=0.0.0.0

# Mode debug
# DEBUG=false
